HF_TOKEN=replace_with_your_huggingface_token
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=glm4
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=600
LLM_MAX_TOKENS=384
LLM_MAX_EVIDENCE_ITEMS=8
LLM_MAX_EVIDENCE_CHARS=180
LLM_CONCURRENCY=3
LLM_KEEP_ALIVE=10m
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=768
LLM_USE_OLLAMA_OPTIONS=1
AGENT_CACHE_ENABLED=1
EMBEDDING_BATCH_SIZE=32
RAG_MAX_WORKERS=4
ASR_DEVICE=
ASR_COMPUTE_TYPE=
ASR_CPU_THREADS=
ASR_NUM_WORKERS=1
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_auth_code
SMTP_FROM=your_email@qq.com
SMTP_USE_SSL=true
